endpoints:
  custom:
    - name: openproxy
      apiKey: dummy
      baseURL: http://openproxy:8080/v1
      models:
        default: [gpt-5-mini, claude-sonnet-4-5, qwen3-coder-30b]
        fetch: true
      titleConvo: true
      titleModel: current_model
      modelDisplayLabel: openproxy
      tokenConfig:
        gpt-5-mini: { context: 128000 }
        claude-sonnet-4-5: { context: 200000 }
        qwen3-coder-30b: { context: 131072 }
